# Rocket.Chat instance URL (sem barra no final)
ROCKETCHAT_URL=https://desk.sapios.chat

# Token de admin/manager para consultar a API REST
ROCKETCHAT_ADMIN_TOKEN=your_admin_token_here
ROCKETCHAT_ADMIN_USER_ID=your_admin_user_id_here

# Secret token configurado em Omnichannel > Webhooks
LIVECHAT_WEBHOOK_SECRET=your_webhook_secret_token

# Secret compartilhado com o bot — exigido no header X-Bot-Token pra chamar
# POST /visitors/register (abre/reabre sala). Sem essa var setada, a rota
# fica sem autenticação — só deixe sem setar em dev local.
BOT_API_SECRET=your_bot_api_secret_here

# Porta do servidor
PORT=3000

# Intervalo em segundos para reconciliação com a API do Rocket.Chat
RECONCILE_INTERVAL_SECONDS=30

# URL base do frontend (para CORS)
FRONTEND_URL=http://localhost:5173

# URL do widget de chat do Rocket.Chat (para redirect após ser atendido)
# Ex: https://your-rocketchat.example.com/livechat
ROCKETCHAT_LIVECHAT_URL=https://your-rocketchat.example.com/livechat

# Mensagem automática enviada como o agente assim que o chat é assumido
# Deixe vazio (LIVECHAT_GREETING_MESSAGE=) para desativar
LIVECHAT_GREETING_MESSAGE=Oi, sou da Sapios, como posso te ajudar?

# Habilita a rota /debug/connect/:token (sem autenticação, força qualquer
# sala pra "conectada"). Deixe SEM setar em produção — só pra dev local.
ENABLE_DEBUG_ROUTES=true
